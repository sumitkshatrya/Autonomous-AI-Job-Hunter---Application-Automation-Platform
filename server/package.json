{
  "name": "@autoapply/server",
  "version": "1.0.0",
  "description": "AutoApply AI Backend REST API Server",
  "main": "dist/index.js",
  "scripts": {
    "build": "node --max-old-space-size=4096 ../node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "dev": "node --max-old-space-size=1024 ../node_modules/tsx/dist/cli.mjs watch --exclude \"**/node_modules/**\" src/index.ts",
    "test": "node ../node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@autoapply/shared": "*",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.0",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "openai": "^4.85.4",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.4",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
